rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidPayloadSize() {
      return request.resource == null || request.resource.data.keys().size() <= 25;
    }

    match /global_flashcards/{cardId} {
      allow read: if true;
      allow write: if false;
    }

    match /global_audio_pronunciations/{audioId} {
      allow read: if true;
      allow write: if false;
    }

    match /global_stories/{storyId} {
      allow read: if true;
      allow write: if false;
    }

    match /global_chapter_stories/{storyId} {
      allow read: if true;
      allow write: if false;
    }

    match /artifacts/{appId}/users/{userId} {
      allow read, write: if isOwner(userId) && isValidPayloadSize();

      match /unlockedCards/{cardId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['unlocked', 'imageUrl', 'updatedAt', 'regenerated', 'regenerateCount'])
          && request.resource.data.unlocked is bool
          && (!('imageUrl' in request.resource.data)
              || request.resource.data.imageUrl == null
              || (request.resource.data.imageUrl is string && request.resource.data.imageUrl.size() <= 2048))
          && (!('regenerated' in request.resource.data) || request.resource.data.regenerated is bool)
          && (!('regenerateCount' in request.resource.data) || (request.resource.data.regenerateCount is number && request.resource.data.regenerateCount >= 0));
        allow delete: if isOwner(userId);
      }

      match /chat/{docId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['messages', 'updatedAt'])
          && request.resource.data.messages is list
          && request.resource.data.messages.size() <= 100;
        allow delete: if isOwner(userId);
      }

      match /pedagogy/{docId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidPayloadSize();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
